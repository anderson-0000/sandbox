    %% ==========================================
    %% 3. REFINED FLOWS (DETAILED)
    %% ==========================================

    %% CI/CD (GitOps) & Image Management
    GitHub_Code -- "1. Build & Push Image" --> GHA_Runner_ACA --> ACR
    GHA_Runner_ACA -- "Deploy / Test" --> SWA
    GHA_Runner_ACA -- "Chaos Experiment" --> ChaosStudio
    ChaosStudio -. "Fault Injection" .-> AKS_E & AKS_W
    GitHub_GitOps -- "2. Sync Manifests" --> ArgoCD_E & ArgoCD_W
    ArgoCD_E & ArgoCD_W -- "3. Pull & Deploy Pods" --> PodE & PodW

    %% AGfC Flow (Symmetric Control)
    ALB_Ctrl_Pod_E -. "Watches Gateway API" .-> AGfC_GW_E
    ALB_Ctrl_Pod_W -. "Watches Gateway API" .-> AGfC_GW_W

    %% External DNS & Cert Manager
    CertMgr_E & CertMgr_W -. "ACME Challenge" .-> LetsEncrypt
    ExtDNS_E & ExtDNS_W -. "Update Records" .-> DNS & PrivateDNS
    CertMgr_E & CertMgr_W -- "Save SSL Certs" --> KV_E & KV_W

    %% Secrets Flow (Zero Trust with Workload ID)
    KV_E -- "4. Sync Secrets" --> ESO_E --> PodE
    KV_W -- "4. Sync Secrets" --> ESO_W --> PodW
    WorkloadID_E & WorkloadID_W -. "OIDC Federated Identity" .-> EntraID

    %% Logs & SIEM (Retention Strategy)
    SideE_FB & SideW_FB -. "Log Forward" .-> LAW
    AMA_E & AMA_W -. "Container Insights" .-> LAW
    AzFW -- "Traffic Logs" --> LAW
    LAW -- "Real-time SIEM Analysis" --> Sentinel
    LAW -- "Data Export" --> Archive_Storage

    %% Observability Hub Flows
    AMA_E & AMA_W -- "Metrics" --> AMW_E & AMW_W
    AMW_E & AMW_W -- "Visualize" --> Grafana
    Grafana -- "PromQL" --> Prometheus

    %% Scaling Flow (Event-driven with KEDA)
    SB_E & SB_W -. "5. Trigger Scale (Metric)" .-> KEDA_E & KEDA_W
    KEDA_E & KEDA_W -- "Scale Pods" --> PodE & PodW

    %% Security & Governance Findings
    Sec_Suite -. "Unified Security Findings" .-> Sentinel
    Sentinel -- "6. Automation / Alert" --> ActionGroup_E & ActionGroup_W
    ActionGroup_E & ActionGroup_W --> LogicApp_Chat_E & LogicApp_Chat_W

    %% AIOps Loop (Auto-Remediation)
    AppInsights_E & AppInsights_W -- "Metric Threshold" --> EventGrid_E & EventGrid_W
    EventGrid_E & EventGrid_W --> RemE_Func & RemW_Func
    RemE_Func & RemW_Func -. "Auto-Fix" .-> AKS_E & AKS_W

    %% Streaming Flow
    APIM_E & APIM_W -- "Ingest Data" --> EH_E & EH_W
    EH_E & EH_W --> ASA_E & ASA_W --> Blob_E & Blob_W

    %% AI Safety Flow
    PodE & PodW -- "Safety Check" --> ContentSafety_E & ContentSafety_W

    %% Connectivity & DR
    User_Ext --> AFD --> AGfC_GW_E & AGfC_GW_W
    Admin_Ext -- "Zero Trust Access" --> Entra_GSA --> AGfC_GW_E & AGfC_GW_W
    Synthetics_E & Synthetics_W -. "Canary Check" .-> AFD
    OnPrem_DC <== "ExpressRoute/VPN" ==> VPN_GW ==> AzFW
    AzFW <== "Global VNet Peering" ==> VNet_East & VNet_West
    
    %% Replication & Data Sync
    SQL_E <== "Failover Group" ==> SQL_W
    Redis_E <== "Geo-Rep" ==> Redis_W
    ACR <== "Geo-Rep" ==> Region_West
    Backup_E & Backup_W -- "Snapshot / Config Backup" --> Blob_E & Blob_W
    Purview_Central -. "Data Scan / Mapping" .-> DataE & DataW

    %% 9. Governance & Enterprise Control
    EntraID -. "RBAC / PIM / IAM" .-> PlatformTitle & LandingTitle
    EntraID -. "Identity Provider" .-> PodE & PodW
    HSM -. "Root Key (BYOK)" .-> KV_E & KV_W
    Policy_E & Policy_W -. "Guardrails" .-> AKSE_Title & AKSW_Title
    AFD -- "WAF Ingress" --> APIM_E & APIM_W
    CostMgmt_E & CostMgmt_W -. "Cost Alert" .-> ActionGroup_E & ActionGroup_W

    %% 10. AI & Data Analytics Flow (RAG)
    ContE -- "1. Vector Search" --> AISearch_E
    AISearch_E -- "2. Retrieve Metadata" --> SQL_E
    ContE -- "3. Prompt & Safety" --> ContentSafety_E -- "4. Generate" --> OpenAI_E
    OpenAI_E -- "5. Store Results" --> Blob_E
    Synapse_E -- "Data Lake Query" --> Blob_E

    %% 11. Orchestration & Task Flow
    Logic_E & Logic_W -- "Orchestrate" --> Func_Biz_E & Batch_E & Func_Biz_W & Batch_W
    Monitor_Alert_E & Monitor_Alert_W -- "Trigger" --> ActionGroup_E & ActionGroup_W

    %% Layout Hints
    RootTitle ~~~ PlatformMG
    MgmtTitle ~~~ LandingTitle
    Region_East ~~~ Region_West

    %% Apply Styles
    class MgmtSubScope mgmt;
    class SharedSub,ConnSub infra;
    class ProdSub work;
    class SIEM_Central,AMA_E,AMA_W,SideE_FB,SideW_FB,Ops_Monitor_E,Ops_Monitor_W,Obs_Layer_E,Obs_Layer_W obs;
    class NodePool_Sys_E,NodePool_Sys_W,NodePool_User_E,NodePool_User_W,Dapr_E,Dapr_W addon;
