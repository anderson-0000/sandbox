graph TD
    %% ==========================================
    %% クラス定義 (色分け)
    %% ==========================================
    classDef mgmt fill:#FFD2D2,stroke:#B30000,stroke-width:3px,color:#000;
    classDef sec fill:#D2FFD2,stroke:#006600,stroke-width:2px,color:#000;
    classDef infra fill:#D2D2FF,stroke:#0000B3,stroke-width:2px,color:#000;
    classDef deploy fill:#E6E6FA,stroke:#4B0082,stroke-width:2px,color:#000;
    classDef data fill:#FFD700,stroke:#B8860B,stroke-width:2px,color:#000;
    classDef work_p fill:#FFFFD2,stroke:#B3B300,stroke-width:2px,color:#000;
    classDef work_c fill:#FFEFD5,stroke:#8B4513,stroke-width:2px,color:#000;
    classDef ops fill:#F0F0F0,stroke:#666,stroke-width:2px,stroke-dasharray: 5 5,color:#000;

    %% ==========================================
    %% Root Hierarchy
    %% ==========================================
    subgraph OrgRoot ["AWS Organization Root"]
        direction TB

        %% 1. Management (支配層)
        MgmtAcc["🏢 Management Account<br/>------------------------------------<br/>【全権限・請求・ガバナンス】<br/>・AWS Organizations (Root)<br/>・Cost & Usage Report (CUR)<br/>・Service Quotas (緩和申請)<br/>⚠️ SCP: ワークロード実行禁止<br/>⚠️ アクセス: Break Glassユーザーのみ"]:::mgmt

        %% 2. Security OU (監視・監査・法医学)
        subgraph SecOU ["🔒 Security OU"]
            LogAcc["📜 Log Archive Account<br/>------------------------------------<br/>【監査証跡の聖域】<br/>・S3 Object Lock (Compliance Mode)<br/>・CloudTrail / Config / VPC Flow Logs<br/>・Athena (監査ログ分析)"]:::sec

            AuditAcc["🛡️ Security Audit (SOC) Account<br/>------------------------------------<br/>【監視センター】<br/>・GuardDuty / Security Hub / Detective<br/>・Inspector (脆弱性管理)<br/>・Incident Manager"]:::sec

            ForensicsAcc["🕵️ Forensics Account<br/>------------------------------------<br/>【証拠保全・解析クリーンルーム】<br/>・侵害されたリソースの隔離場所<br/>・マルウェア解析環境(インターネット遮断)<br/>・法執行機関提出用データ保全"]:::sec
        end

        %% 3. Infrastructure OU (ネットワーク・ID)
        subgraph InfraOU ["🏗️ Infrastructure OU"]
            NetAcc["🌐 Network Account<br/>------------------------------------<br/>【通信制御の要】<br/>・Transit Gateway (TGW) - 全通信のハブ<br/>・Ingress / Egress VPC (集約WAF/Proxy)<br/>・Network Firewall (IPS/IDS)<br/>・Direct Connect Gateway (閉域網)"]:::infra

            IdAcc["🆔 Identity Account<br/>------------------------------------<br/>【認証基盤】<br/>・IAM Identity Center [委任管理者]<br/>・外部IdP連携 (AzureAD/Okta)<br/>・SAML/OIDCプロバイダー設定"]:::infra
        end

        %% 4. Deployments OU (CI/CD専用 - ★ここを独立させる)
        subgraph DeployOU ["🚀 Deployments OU (供給連鎖)"]
            CicdAcc["🛠️ CI/CD Pipeline Account<br/>------------------------------------<br/>【本番変更の唯一の入り口】<br/>・CodePipeline / GitHub Runners<br/>・Artifacts (ECR / CodeArtifact)<br/>・このアカウントのみがProdへの<br/>　AssumeRole(変更権限)を持つ"]:::deploy
        end

        %% 5. Data Protection OU (BCP)
        subgraph DataOU ["💾 Data Protection OU"]
            BackupAcc["vault Backup Vault Account<br/>------------------------------------<br/>【最後の砦・Air Gap】<br/>・AWS Backup Vault (クロスアカウント)<br/>・KMS (暗号化キーの隔離)<br/>・Sourceアカウントからの削除不可設定"]:::data
        end

        %% 6. Workloads OU (本番 - 階層防御)
        subgraph ProdOU ["🏢 Workloads (Prod) OU"]
            direction TB
            subgraph Frontend ["Frontend / DMZ Layer"]
                ProdPub["🟢 Prod Public Account<br/>------------------------------------<br/>・ALB / API Gateway / CDN<br/>・WAF適用<br/>・インターネット接続: あり(Network経由)"]:::work_p
            end
            
            subgraph Backend ["Backend / Core Layer"]
                ProdPriv["🟤 Prod Core Banking/DB Account<br/>------------------------------------<br/>・App Server / RDS / DynamoDB<br/>・インターネット接続: 完全遮断<br/>・FrontendからのAPIコールのみ許可"]:::work_c
            end
        end

        %% 7. Workloads OU (SDLC - 開発)
        subgraph SdlcOU ["💻 Workloads (SDLC) OU"]
            StgAcc["🟡 Staging Account (Pre-Prod)"]:::work_p
            DevAcc["🔵 Development Account"]:::work_p
        end

        %% 8. Operations & Lifecycle (運用・維持)
        subgraph OpsOU ["🔧 Operations OU"]
            SharedOps["⚙️ Shared Services Account<br/>------------------------------------<br/>【共通ツール(非特権)】<br/>・Active Directory (AD)<br/>・Bastion / Jump Server (踏み台)<br/>・Scanner / Patch Manager"]:::infra
            
            PolicyStg["🧪 Policy Staging Account<br/>------------------------------------<br/>【SCP動作検証】<br/>・新規SCP/権限セットのテスト場<br/>・ロックアウト回避のためのドライラン"]:::ops
        end

        %% 9. Suspended / Sandbox
        subgraph SuspendedOU ["🚫 Suspended OU"]
            TrashAcc["🗑️ Suspended Account (DenyAll)"]:::ops
        end
        
        subgraph SandOU ["🏖️ Sandbox OU"]
            SandAcc["🧸 Sandbox Account (Isolated)"]:::ops
        end
    end

    %% ==========================================
    %% 厳格なデータフローと権限委譲
    %% ==========================================
    
    %% 認証フロー
    IdAcc -.->|SSO| CicdAcc
    IdAcc -.->|SSO| ProdPub
    IdAcc -.->|SSO| ProdPriv
    
    %% デプロイフロー (Supply Chain Security)
    CicdAcc ==>|"1. Assume Role (Deploy)"| ProdPub
    CicdAcc ==>|"1. Assume Role (Deploy)"| ProdPriv
    CicdAcc -.->|"Images/Artifacts"| ProdPub
    
    %% ネットワークフロー (Traffic Inspection)
    NetAcc ==o|"2. Ingress/Egress Inspection"| ProdPub
    ProdPub ==o|"3. Internal API"| ProdPriv
    
    %% バックアップフロー (Ransomware Protection)
    ProdPub -.->|"4. Cross-Account Copy"| BackupAcc
    ProdPriv -.->|"4. Cross-Account Copy"| BackupAcc

    %% ログフロー
    MgmtAcc -.->|"5. Audit Logs"| LogAcc
    NetAcc -.->|"5. Traffic Logs"| LogAcc
