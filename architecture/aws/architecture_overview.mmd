graph TD
    %% ==========================================
    %% 0. EXTERNAL ACTORS
    %% ==========================================
    subgraph Actors["Users & Connectivity"]
        User_Ext("User (Internet/App)")
        Admin_Ext("Admin / Internal Ops")
        OnPrem_DC("Corporate Data Center")
    end

    %% ==========================================
    %% 1. AWS CLOUD SCOPE
    %% ==========================================
    subgraph AWS["AWS Cloud (Serverless Enterprise Active-Active Environment)"]
        direction TB

        %% --- 1.1 GLOBAL EDGE & NETWORK ---
        subgraph Global_Layer["Global Edge & Network Backbone"]
            direction TB
            
            subgraph Edge_Sec["Edge Security (Zero Trust Entry)"]
                R53("Route 53 (DNS)")
                WAF("WAF / Shield Advanced<br/>(Auto-Block)")
                CF("CloudFront (CDN)")
                AVA("AWS Verified Access (Zero Trust)")
                IAM_IC("IAM Identity Center")
