    classDef mgmt fill:#FFD2D2,stroke:#B30000,stroke-width:2px,color:#000;
    classDef sec fill:#D2FFD2,stroke:#006600,stroke-width:2px,color:#000;
    classDef infra fill:#D2D2FF,stroke:#0000B3,stroke-width:2px,color:#000;
    classDef work fill:#FFFFD2,stroke:#B3B300,stroke-width:2px,color:#000;
    classDef data fill:#E6CCFF,stroke:#4B0082,stroke-width:2px,color:#000;
    classDef obs fill:#E1F5FE,stroke:#01579B,stroke-width:2px,color:#000;
    classDef gitops fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#000;

    classDef groupTitle fill:none,stroke:none,color:#000,font-weight:bold,font-size:16px,align:center;
    classDef subTitle fill:none,stroke:none,color:#000,font-weight:bold,font-size:14px,align:center;

    %% ==========================================
    %% 0. EXTERNAL ACTORS
    %% ==========================================
    subgraph Actors["Users & Connectivity"]
        User_Ext("User (Internet/App)")
        Admin_Ext("Admin / Internal Ops")
        OnPrem_DC("Corporate Data Center")
        GitHub_Ext("GitHub Enterprise/Cloud<br/>(GitOps Source)")
        Amplify("AWS Amplify (Static Web)")
    end

    %% ==========================================
    %% 1. AWS ORGANIZATION SCOPE
    %% ==========================================
    subgraph AWS_Org [" "]
        direction TB
        OrgTitle["🏢 AWS Organization (Serverless Enterprise Environment)"]:::groupTitle

        %% --- 1.1 MANAGEMENT ACCOUNT ---
        subgraph MgmtAcc [" "]
            direction TB
            MgmtAccTitle["🏢 Management Account"]:::subTitle
            IAM_IC("IAM Identity Center")
            Org_SCP("Organizations / SCP")
            Billing("Billing & Cost Mgmt")
            subgraph SIEM_Central [" "]
                SIEMTitle["📊 SIEM & Observability Hub"]:::subTitle
                SecHub("AWS Security Hub"):::sec
                AMP_Central("Managed Prometheus (Central)"):::obs
                AMG_Central("Managed Grafana (Central)"):::obs
                CW_Logs_Central("CloudWatch Logs (Central)"):::obs
                S3_Audit("S3 (Log Archive/WORM)"):::sec
            end
        end

        %% --- 1.2 INFRASTRUCTURE OU ---
        subgraph InfraOU [" "]
            direction TB
            InfraTitle["🏗️ Infrastructure OU"]:::subTitle

            subgraph NetAcc [" "]
                direction TB
                NetAccTitle["🌐 Network Account"]:::subTitle
                subgraph Global_Layer [" "]
                    GlobalLayerTitle["🌍 Global Edge & Network Backbone"]:::subTitle
                    subgraph Edge_Sec [" "]
                        EdgeSecTitle["🛡️ Edge Security (Zero Trust Entry)"]:::subTitle
                        R53("Route 53 (DNS)")
                        GA("Global Accelerator (Anycast IP)")
                        WAF("WAF / Shield Advanced"):::sec
                        CF("CloudFront (CDN)")
                        AVA("AWS Verified Access (Zero Trust)"):::sec
                        ARC("Route 53 ARC (Routing Control)")
                    end
                    subgraph Inspection_VPC [" "]
                        InspTitle["🔍 Inspection VPC"]:::subTitle
                        GWLB("Gateway Load Balancer")
                        ANFW("AWS Network Firewall"):::sec
                    end
                    subgraph Backbone [" "]
                        BackboneTitle["Transit Gateway Backbone"]:::subTitle
                        TGW_T[("TGW (Tokyo)")] <== "Encrypted Peering" ==> TGW_O[("TGW (Osaka)")]
                        DXGW("Direct Connect Gateway")
                    end
                end
            end

            subgraph SharedAcc [" "]
                direction TB
                SharedAccTitle["🛠️ Shared Services Account"]:::subTitle
                subgraph CICD [" "]
                    CICDTitle["♾️ DevSecOps Pipeline (Code Series)"]:::gitops
                    CodeCommit("AWS CodeCommit"):::gitops
                    CodePipeline("CodePipeline"):::gitops
                    CodeBuild("CodeBuild"):::gitops
                    CB_Runner("CodeBuild (GitHub Actions Runner)"):::gitops
                    CodeGuru_Rev("CodeGuru Reviewer (AI Audit)"):::gitops
                    Vuln_Scan("Vuln Scan (Trivy / Inspector)"):::sec
                    Signer("AWS Signer (Image Signing)"):::sec
                    CodeDeploy("CodeDeploy (Blue/Green)"):::gitops
                    FIS("AWS FIS (Chaos Testing)"):::infra
                end
            end
        end

        %% --- 1.4 WORKLOADS OU (PRODUCTION) ---
        subgraph ProdOU [" "]
            direction TB
            ProdOUTitle["🚀 Workloads (Prod) OU"]:::subTitle
            subgraph ProdAcc [" "]
                direction TB
                ProdAccTitle["🟢 Production Account"]:::subTitle
                
                %% ==========================================
                %% TOKYO REGION
                %% ==========================================
                subgraph Region_Tokyo [" "]
                    direction TB
                    TokyoTitle["🌏 Region: Tokyo (ap-northeast-1)"]:::subTitle

                    subgraph GenAI_Layer_T [" "]
                        style GenAI_Layer_T fill:#f9f2ff,stroke:#6600cc,stroke-width:2px,stroke-dasharray: 5 5
                        GenAITitle_T["🤖 Generative AI (Bedrock)"]:::data
                        Bedrock_Model_T("Amazon Bedrock (FMs)"):::data
                        Bedrock_KB_T("Knowledge Base (RAG)"):::data
                        Bedrock_Guard_T("Guardrails (Safety)"):::data
                    end

                    subgraph AIOps_Center_T [" "]
                        style AIOps_Center_T fill:#f0f8ff,stroke:#0052cc,stroke-width:2px
                        AIOpsTitle_T["🤖 AIOps & Automation"]:::obs
                        DevOps_Guru_T("Amazon DevOps Guru"):::obs
                        EventBridge_T("EventBridge")
                        AppConfig_T("AWS AppConfig")
                        subgraph Remediation_T [" "]
                            RemT_Title["Auto-Remediation"]:::subTitle
                            Lambda_Fix_T("Lambda (Auto-Fix)")
                            SSM_Auto_T("SSM Automation")
                        end
                    end

                    subgraph Gov_T [" "]
                        GovT_Title["🛡️ Regional Governance"]:::subTitle
                        KMS_T("KMS (Multi-Region Key)"):::sec
                        ACM_T("ACM (SSL Certs)"):::sec
                        Secrets_T("Secrets Manager"):::sec
                        Config_T("AWS Config")
                        Backup_T("AWS Backup (Vault Lock)")
                        GD_T("GuardDuty"):::sec
                        Inspector_T("Inspector"):::sec
                        Macie_T("Macie"):::sec
                        subgraph Ops_Monitor_T [" "]
                            MonT_Title["Ops Monitoring"]:::subTitle
                            CW_Alarm_T("CloudWatch Alarms"):::obs
                            Synthetics_T("Synthetics (Canary)"):::obs
                            SNS_T("SNS Topic")
                            Chatbot_T("AWS Chatbot (Slack)")
                        end
                        CostAnomaly_T("Cost Anomaly Detection")
                    end

                    subgraph VPC_Tokyo [" "]
                        direction TB
                        VPCT_Title["🌐 VPC (Tokyo)"]:::subTitle
                        subgraph Public_T [" "]
                            PublicTTitle["🚦 Public Subnet (DMZ)"]:::subTitle
                            NAT_T("NAT Gateway")
                            ALB_T("ALB (Internal/External)")
                            APIGW_T("API Gateway")
                        end
                        subgraph App_Layer_T [" "]
                            AppTTitle["🚀 App Layer (Private)"]:::subTitle
                            Lattice_T("VPC Lattice (AuthZ)"):::infra
                            subgraph Streaming_T [" "]
                                style Streaming_T fill:#fff5e6,stroke:#ff9900,stroke-width:2px
                                StreamTTitle["🌊 Streaming"]:::subTitle
                                KDS_T("Kinesis Data Streams")
                                KDF_T("Kinesis Firehose")
                            end
                            subgraph ECS_Cluster_T [" "]
                                style ECS_Cluster_T fill:#fff,stroke:#d45d00,stroke-width:2px
                                ECSTTitle["⚙️ ECS Cluster (Fargate)"]:::work
                                subgraph ECS_Service_T [" "]
                                    direction TB
                                    AutoScaling_T("Predictive Scaling")
                                    subgraph Fargate_Task_T [" "]
                                        direction LR
                                        App_Cont_T("App Container")
                                        subgraph Sidecars_T [" "]
                                            Envoy_T("Envoy Proxy (Mesh)")
                                            FireLens_T("FireLens (Log)")
                                            XRay_T("X-Ray / ADOT")
                                            CodeGuru_Prof_T("CodeGuru Profiler")
                                        end
                                    end
                                end
                            end
                            Lambda_Biz_T("Lambda (Biz)")
                            SFN_T("Step Functions")
                            AWS_Batch_T("AWS Batch (Fargate)"):::work
                            SQS_T("SQS (Job Queue)")
                            DLQ_T("SQS DLQ")
                            Cognito_T("Amazon Cognito"):::sec
                        end
                        subgraph Data_Layer_T [" "]
                            DataTTitle["💾 Data Layer (Private)"]:::subTitle
                            Aurora_T("Aurora Global (Writer)"):::data
                            Redis_T("ElastiCache (Cache)"):::data
                            AOSS_T("OpenSearch Serverless"):::data
                            Athena_T("Athena (Serverless Query)"):::data
                            Glue_T("Glue (Catalog)"):::data
                        end
                        subgraph EPs_T ["🛡️ Interface Endpoints"]
                            EP_S3_T("S3 Gateway EP")
                            EP_Bedrock_T("EP: Bedrock Runtime")
                            EP_Kinesis_T("EP: Kinesis")
                            EP_Sec_T("EP: KMS / Secrets / ECR")
                        end
                    end
                    S3_T("S3 Bucket (Data)"):::data
                    ECR_T("ECR Registry"):::infra
                end

                %% ==========================================
                %% OSAKA REGION (SECONDARY - FULL MIRROR)
                %% ==========================================
                subgraph Region_Osaka [" "]
                    direction TB
                    OsakaTitle["🌏 Region: Osaka (ap-northeast-3)"]:::subTitle
                    subgraph GenAI_Layer_O [" "]
                        style GenAI_Layer_O fill:#f9f2ff,stroke:#6600cc,stroke-width:2px,stroke-dasharray: 5 5
                        Bedrock_Model_O("Amazon Bedrock"):::data
                        Bedrock_KB_O("Knowledge Base"):::data
                        Bedrock_Guard_O("Guardrails"):::data
                    end
                    subgraph AIOps_Center_O [" "]
                        style AIOps_Center_O fill:#f0f8ff,stroke:#0052cc,stroke-width:2px
                        DevOps_Guru_O("Amazon DevOps Guru"):::obs
                        EventBridge_O("EventBridge")
                        AppConfig_O("AWS AppConfig")
                        subgraph Remediation_O [" "]
                            Lambda_Fix_O("Lambda (Auto-Fix)")
                            SSM_Auto_O("SSM Automation")
                        end
                    end
                    subgraph Gov_O [" "]
                        KMS_O("KMS (Replica Key)"):::sec
                        ACM_O("ACM (SSL Certs)"):::sec
                        Secrets_O("Secrets Manager"):::sec
                        Config_O("AWS Config")
                        Backup_O("AWS Backup")
                        GD_O("GuardDuty"):::sec
                        Inspector_O("Inspector"):::sec
                        subgraph Ops_Monitor_O [" "]
                            CW_Alarm_O("CloudWatch Alarms"):::obs
                            Synthetics_O("Synthetics (Canary)"):::obs
                            SNS_O("SNS Topic")
                            Chatbot_O("AWS Chatbot")
                        end
                    end
                    subgraph VPC_Osaka [" "]
                        direction TB
                        subgraph Public_O [" "]
                            NAT_O("NAT Gateway")
                            ALB_O("ALB")
                            APIGW_O("API Gateway")
                        end
                        subgraph App_Layer_O [" "]
                            Lattice_O("VPC Lattice"):::infra
                            subgraph Streaming_O [" "]
                                style Streaming_O fill:#fff5e6,stroke:#ff9900,stroke-width:2px
                                KDS_O("Kinesis Data Streams")
                                KDF_O("Kinesis Firehose")
                            end
                            subgraph ECS_Cluster_O [" "]
                                style ECS_Cluster_O fill:#fff,stroke:#d45d00,stroke-width:2px
                                subgraph ECS_Service_O [" "]
                                    AutoScaling_O("Predictive Scaling")
                                    subgraph Fargate_Task_O [" "]
                                        direction LR
                                        App_Cont_O("App Container")
                                        subgraph Sidecars_O [" "]
                                            Envoy_O("Envoy Proxy")
                                            FireLens_O("FireLens")
                                            XRay_O("X-Ray")
                                            CodeGuru_Prof_O("CodeGuru Profiler")
                                        end
                                    end
                                end
                            end
                            Lambda_Biz_O("Lambda")
                            SFN_O("Step Functions")
                            AWS_Batch_O("AWS Batch"):::work
                            SQS_O("SQS")
                            DLQ_O("SQS DLQ")
