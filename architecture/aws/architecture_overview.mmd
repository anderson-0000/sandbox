                    end
                    S3_O("S3 Bucket"):::data
                    ECR_O("ECR Registry"):::infra
                end
            end
        end
    end

    %% ==========================================
    %% 3. CONNECTIONS & FLOWS (COMPLETE)
    %% ==========================================

    %% 1. User Access & Global Edge
    User_Ext --> R53
    R53 --> CF
    CF -- "HTTPS (ACM)" --> WAF
    User_Ext -- "High Speed" --> GA -- "Anycast" --> ALB_T & ALB_O
    WAF --> APIGW_T & APIGW_O
    WAF --> ALB_T & ALB_O
    R53 -- "Static Content" --> Amplify
    Admin_Ext -- "Zero Trust Access" --> AVA --> ALB_T & ALB_O
    Synthetics_T & Synthetics_O -. "Canary Check" .-> CF

    %% 2. Network Backbone & INSPECTION
    OnPrem_DC <== "Direct Connect" ==> DXGW ==> TGW_T & TGW_O
    TGW_T <== "Traffic Inspection" ==> GWLB <== "GENEVE" ==> ANFW
    TGW_T <== "Peering" ==> TGW_O

    %% 3. CI/CD Pipeline & Chaos
    GitHub_Ext -- "Webhook" --> CB_Runner
    CB_Runner -- "1. Build & Push" --> ECR_T
    CB_Runner -- "2. AI Review / Scan" --> CodeGuru_Rev & Vuln_Scan
    CB_Runner -- "3. Chaos Experiment" --> FIS
    FIS -. "Fault Injection" .-> ECS_Service_T & ECS_Service_O
    Vuln_Scan -- "4. Sign Artifact" --> Signer
    Signer -- "5. Deploy" --> CodeDeploy --> ECS_Service_T & ECS_Service_O

    %% 4. Internal Service Flow & Lattice
    ALB_T --> Envoy_T -- "Proxy" --> App_Cont_T
    ALB_O --> Envoy_O -- "Proxy" --> App_Cont_O
    Lattice_T -. "Service-to-Service" .-> ECS_Service_T & Lambda_Biz_T
    Lattice_O -. "Service-to-Service" .-> ECS_Service_O & Lambda_Biz_O
    AppConfig_T & AppConfig_O -. "Dynamic Config" .-> App_Cont_T & App_Cont_O

    %% 5. Data & GenAI Flow (RAG)
    App_Cont_T -- "1. Cache Check" --> Redis_T
    App_Cont_T -- "2. DB Write" --> Aurora_T
    App_Cont_T -- "3. Invoke LLM" --> EP_Bedrock_T -.-> Bedrock_Model_T
    Bedrock_Model_T --> Bedrock_Guard_T --> Bedrock_KB_T
    Bedrock_KB_T -- "4. Vector Search" --> AOSS_T
    Bedrock_KB_T -- "5. Retrieve Data" --> S3_T
    App_Cont_T -- "6. Safety Check" --> Bedrock_Guard_T

    %% 6. Streaming Flow
    APIGW_T & APIGW_O -- "Ingest" --> KDS_T & KDS_O
    KDS_T & KDS_O --> KDF_T & KDF_O --> S3_T & S3_O
    KDF_T & KDF_O --> AOSS_T & AOSS_O

    %% 7. Telemetry & AIOps Loop
    FireLens_T & FireLens_O -- "Logs" --> CW_Logs_Central
    XRay_T & XRay_O -. "Trace" .-> EP_Sec_T
    CodeGuru_Prof_T & CodeGuru_Prof_O -. "Profile" .-> DevOps_Guru_T & DevOps_Guru_O
    DevOps_Guru_T & DevOps_Guru_O -- "Anomaly Event" ==> EventBridge_T & EventBridge_O
    EventBridge_T & EventBridge_O --> Lambda_Fix_T & SSM_Auto_T
    EventBridge_T & EventBridge_O --> SNS_T & SNS_O --> Chatbot_T

    %% 8. Security Aggregation (Central SIEM)
    GD_T & GD_O & Inspector_T & Inspector_O & Macie_T & Config_T -. "Findings" .-> SecHub
    SecHub -- "Visualize" --> AMG_Central
    CW_Logs_Central -- "Analysis" --> Sentinel_Ext["Third-party SIEM (Optional)"]
    CW_Logs_Central -- "Metrics" --> AMP_Central -- "Visualize" --> AMG_Central
    CW_Logs_Central & SecHub -- "Archive" --> S3_Audit

    %% 9. Replication & FinOps
    Aurora_T <== "Global Rep" ==> Aurora_O
    Redis_T <== "Global Rep" ==> Redis_O
    S3_T -. "CRR" .-> S3_O
    ECR_T -. "Cross-Region Rep" .-> ECR_O
    CostAnomaly_T -. "Cost Spike" .-> SNS_T

    %% 10. Governance & Enterprise Control
    IAM_IC -. "Identity/SSO" .-> InfraTitle & ProdOUTitle
    Org_SCP -. "Guardrails (SCP)" .-> InfraTitle & ProdOUTitle
    ARC -. "Cross-Region Failover" .-> ALB_T & ALB_O
    ACM_T & ACM_O -. "Cert" .-> ALB_T & ALB_O
    KMS_T & Secrets_T -. "Key/Secret" .-> ECS_Service_T & Lambda_Biz_T
    Backup_T & Backup_O -. "Data Protection" .-> Aurora_T & S3_T & Aurora_O & S3_O
    Cognito_T & Cognito_O -. "User Auth" .-> APIGW_T & APIGW_O
    Athena_T & Athena_O -- "Analytics" --> Glue_T & Glue_O -- "Schema" --> S3_T & S3_O
    SFN_T & SFN_O -- "Task Flow" --> Lambda_Biz_T & AWS_Batch_T & Lambda_Biz_O & AWS_Batch_O
    CW_Alarm_T & CW_Alarm_O -- "Threshold" --> SNS_T & SNS_O

    %% Apply Styles
    class MgmtAcc mgmt;
    class SecOU,LogAcc,AuditAcc,SecHub,GD_T,GD_O,Inspector_T,Inspector_O,Macie_T,ANFW,WAF,AVA sec;
    class InfraOU,NetAcc,SharedAcc,TGW_T,TGW_O,Lattice_T,Lattice_O infra;
    class ProdOU,ProdAcc work;
    class SIEM_Central,CW_Logs_Central,AMP_Central,AMG_Central,Ops_Monitor_T,Ops_Monitor_O,Obs_Layer_E,Obs_Layer_W obs;
    class CICD,CodeCommit,CodePipeline,CodeBuild,CB_Runner,CodeGuru_Rev,CodeDeploy gitops;
