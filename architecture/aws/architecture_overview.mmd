                        subgraph Data_Layer_O [" "]
                            Aurora_O("Aurora (Replica)"):::data
                            Redis_O("ElastiCache (Replica)"):::data
                            AOSS_O("OpenSearch Serverless"):::data
                            Athena_O("Athena"):::data
                            Glue_O("Glue"):::data
                        end
                        subgraph EPs_O ["🛡️ Interface Endpoints"]
                            EP_S3_O("S3 Gateway EP")
                            EP_Bedrock_O("EP: Bedrock")
                            EP_Kinesis_O("EP: Kinesis")
